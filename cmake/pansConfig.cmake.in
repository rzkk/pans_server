@PACKAGE_INIT@

    # notes 
    #PACKAGE_INIT 是 configure_package_config_file() 识别并替换的特殊占位符。
    #PACKAGE_INIT 生成的初始化代码可以提供：PACKAGE_PREFIX_DIR , 用于表示当前安装包的根目录。
    # 还提供两个辅助宏 ：   set_and_check(MY_INCLUDE_DIR"${PACKAGE_PREFIX_DIR}/include")  能够设置变量并检查对应路径是否存在。
    #                      check_required_components(pans)   用于检查使用者请求的必需组件是否已经找到。


include(CMakeFindDependencyMacro)
find_dependency(Threads) 
# 自动继承外层的 REQUIRED / QUIET / COMPONENTS
# 给用户用的 ， 用户可以直接使用 thread , 不需要 find_package(thread)

find_dependency(yaml-cpp CONFIG)
find_dependency(PkgConfig)

pkg_check_modules(
        PANS_LIBDW
        REQUIRED
        IMPORTED_TARGET
        libdw
    )

include("${CMAKE_CURRENT_LIST_DIR}/pansTargets.cmake")
    #CMAKE_CURRENT_LIST_DIR : 表示当前正在执行的 .cmake 文件所在的目录
    #这里是安装后的 lib/cmake/pans/
    # 

check_required_components(pans)
    #用于检查 find_package() 请求的必需组件是否存在。

# ③ 依赖 ① 提供的宏；② 必须在 ③ 之前，否则组件检查时目标还不存在。
